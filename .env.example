# Copie pra .env e preencha.  (o .env nunca vai pro git)

# porta e interface onde o servidor escuta
PORT=3000
HOST=0.0.0.0

# endereço público do site (usado no RSS e na checagem de origem dos formulários)
SITE_URL=https://blog.exemplo.com

# login do painel (/admin)
ADMIN_USUARIO=hb
# gere com:  npm run senha
ADMIN_SENHA_HASH=

# true quando o site estiver atrás de HTTPS (cookie Secure + HSTS)
COOKIE_SEGURO=true
# true quando tiver nginx/caddy/traefik na frente (pra pegar o IP real no limite de tentativas de login)
CONFIAR_PROXY=true

# onde ficam o banco (blog.db) e os anexos (uploads/)
PASTA_DADOS=./data
UPLOAD_MAX_MB=15

FUSO_HORARIO=America/Sao_Paulo
EMAIL_CONTATO=contato@huntbuddy.fun
